{
  "name": "my-opencode-toolkit",
  "version": "0.2.31",
  "description": "OpenCode 插件：系统通知、持久目标、定时任务与 TUI 面板",
  "type": "module",
  "license": "MIT",
  "author": "1cyberlangke1",
  "homepage": "https://github.com/1cyberlangke1/my-opencode-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1cyberlangke1/my-opencode-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/1cyberlangke1/my-opencode-toolkit/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "notification",
    "goal",
    "cron",
    "tui"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "src",
    "dist",
    "index.ts",
    "tui.ts"
  ],
  "dependencies": {
    "effect": "4.0.1",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.32",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sync:version": "bun scripts/sync-version.mjs",
    "version": "bun run sync:version",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tui && pnpm check:package",
    "check:package": "node scripts/check-package.mjs",
    "build:tui": "bun scripts/build-tui.mjs",
    "prepack": "bun run sync:version && bun run build:tui",
    "test": "vitest run",
    "test:tui": "cd tui-test && bun test",
    "test:e2e": "bun scripts/e2e-load.mjs && bun scripts/e2e-tool-visibility.mjs && bun scripts/e2e-synthetic.mjs && bun scripts/e2e-synthetic.mjs --compact && bun scripts/e2e-update.mjs",
    "test:e2e:synthetic": "bun scripts/e2e-synthetic.mjs",
    "test:e2e:compact": "bun scripts/e2e-synthetic.mjs --compact",
    "test:e2e:tui": "bun scripts/e2e-tui.mjs",
    "test:e2e:tool-visibility": "bun scripts/e2e-tool-visibility.mjs",
    "test:e2e:update": "bun scripts/build-tui.mjs && bun scripts/e2e-update.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/plugin": "^2.1.2",
    "@opencode/theme": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^26.6.5",
    "@xterm/headless": "^6.0.0",
    "eslint": "^10.13.0",
    "solid-js": "1.9.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
